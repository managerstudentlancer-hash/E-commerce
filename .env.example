# Server Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/vexivo
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Optional Stripe / Payment Credentials (Sandbox / Test Mode)
STRIPE_PUBLIC_KEY=pk_test_sample_placeholder
STRIPE_SECRET_KEY=sk_test_sample_placeholder

# ========================================================
# OBSERVABILITY & MONITORING (Sentry + Pino)
# ========================================================
# Backend Structured Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Sentry Backend Error Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=vexivo@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Frontend Client Error Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=vexivo-client@1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
