# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection String
# Leave empty or default to use embedded in-memory MongoDB automatically
MONGODB_URI=mongodb://127.0.0.1:27017/vexivo

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRE=30d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Supabase Storage Configuration
# Persistent cloud image storage for products, categories, banners, profiles, sellers
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_BUCKET=vexivo-images
